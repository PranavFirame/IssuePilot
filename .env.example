# ==========================================
# IssuePilot Environment Configuration
# ==========================================

# Base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# GitHub API (Optional but Recommended)
# ------------------------------------------
# Without a token, GitHub limits unauthenticated requests to 60 per hour per IP.
# Providing a Personal Access Token (classic with public_repo read or fine-grained read-only)
# raises your limit to 5,000 requests per hour.
GITHUB_TOKEN=

# ------------------------------------------
# GitHub OAuth Authentication (Optional)
# ------------------------------------------
# To enable one-click "Continue with GitHub" OAuth sign-in:
# 1. Go to: https://github.com/settings/developers -> OAuth Apps -> New OAuth App
# 2. Application Name: IssuePilot
# 3. Homepage URL: http://localhost:3000
# 4. Authorization callback URL: http://localhost:3000/api/auth/github/callback
# Note: Email/password authentication is fully functional without these!
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------
# Google OAuth Authentication (Optional)
# ------------------------------------------
# To enable one-click "Continue with Google" OAuth sign-in:
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Create Credentials -> OAuth client ID -> Web application
# 3. Authorized JavaScript origins: http://localhost:3000
# 4. Authorized redirect URIs: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------
# AI Provider Configuration (Optional)
# ------------------------------------------
# If not configured, repository analysis, duplicate detection, health scoring,
# filtering, and exports will still function completely.
# Supported providers: "gemini" (default) or "openai"
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Gemini API key (recommended)
# Get one for free at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API key (alternative)
OPENAI_API_KEY=

# ------------------------------------------
# Database Persistence (Prisma ORM)
# ------------------------------------------
# Local development default is SQLite (zero-setup file database):
DATABASE_URL="file:./dev.db"

# For production with PostgreSQL (see docker-compose.yml):
# DATABASE_URL="postgresql://issuepilot:issuepilot_secret@localhost:5432/issuepilot_db?schema=public"

# ------------------------------------------
# Optional Redis Cache
# ------------------------------------------
# REDIS_URL="redis://localhost:6379"
