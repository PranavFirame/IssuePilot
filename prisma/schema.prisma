generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  passwordHash   String?   // null for OAuth-only users
  bio            String?
  avatarUrl      String?
  githubId       String?   @unique
  githubUsername String?
  isVerified     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String   @default("oauth")
  provider          String   // "github"
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String   // email or userId
  token      String   @unique
  type       String   // "email_verification" | "password_reset"
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([token])
}

model SavedAnalysis {
  id              String   @id @default(cuid())
  userId          String?  @default("default-user")
  owner           String
  repo            String
  repoName        String
  description     String?
  stars           Int      @default(0)
  forks           Int      @default(0)
  openIssues      Int      @default(0)
  openPrs         Int      @default(0)
  healthScore     Int      @default(0)
  primaryLanguage String?
  dataSnapshot    String   // JSON serialized full analysis data
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([owner, repo])
  @@index([createdAt])
}

model TriageSnapshot {
  id              String   @id @default(cuid())
  owner           String
  repo            String
  issueNumber     Int
  issueTitle      String
  category        String   // bug, feature, docs, question, enhancement
  priority        String   // critical, high, medium, low
  confidence      Float?
  reasoning       String
  missingInfo     String   // JSON array of strings
  suggestedLabels String   // JSON array of strings
  createdAt       DateTime @default(now())

  @@index([owner, repo, issueNumber])
}

model TrackedIssue {
  id            String   @id @default(cuid())
  userId        String   @default("default-user")
  issueNumber   Int
  repoOwner     String
  repoName      String
  title         String
  htmlUrl       String
  state         String   @default("open") // "open" | "closed"
  status        String   @default("saved") // "saved" | "interested" | "in_progress" | "completed"
  notes         String?
  labels        String   @default("[]") // JSON string array of label names
  language      String?
  difficulty    String?  // "good first issue", "help wanted", "documentation"
  prUrl         String?  // Linked GitHub pull request URL if completed
  isPrConfirmed Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, repoOwner, repoName, issueNumber])
  @@index([userId, status])
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique @default("default-user")
  languages       String   @default("[\"TypeScript\",\"JavaScript\",\"Python\"]") // JSON array
  experienceLevel String   @default("beginner") // "beginner" | "intermediate" | "advanced"
  topics          String   @default("[\"web\",\"react\",\"tools\"]") // JSON array
  monthlyGoal     Int      @default(3)
  updatedAt       DateTime @updatedAt
}

model RecentlyViewedIssue {
  id          String   @id @default(cuid())
  userId      String   @default("default-user")
  issueNumber Int
  repoOwner   String
  repoName    String
  title       String
  htmlUrl     String
  language    String?
  viewedAt    DateTime @default(now())

  @@index([userId, viewedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  target    String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}
